#!/bin/bash
echo "Running dart pub publish --dry-run..."

# Analyze
echo "Analyzing project..."
flutter analyze

if [ $? -ne 0 ]; then
  echo "❌ Analysis issues found. Please fix them before committing."
  exit 1
fi

# Run the command and capture output and status
output=$(dart pub publish --dry-run 2>&1)
exit_code=$?

echo "$output"

# If it failed but only due to warnings about modified files, allow it
if [ $exit_code -ne 0 ]; then
  if echo "$output" | grep -q "Package validation found the following potential issue"; then
    echo "⚠️ Dry run completed with warnings (e.g., modified files). Proceeding with commit."
    exit 0
  else
    echo "❌ Dry run failed. Fix the errors above before committing."
    exit 1
  fi
fi

echo "✅ Dry run passed."
exit 0
